# Application
APP_NAME=TACTIX
NODE_ENV=production
BUILD_TAG=latest

# Backend
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tactix
POSTGRES_PASSWORD=
POSTGRES_DB=tactix
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT / Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin
ADMIN_PORT=3000

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Logging
LOG_LEVEL=info
LOG_FORMAT=json